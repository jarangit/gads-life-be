meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{local}}/admin/collection-items
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  X-ADMIN-KEY: {{api-key}}
}

body:json {
  {
    "collectionId": "mvUHpHsewy",
    "productId": "7kNjVXMV5H",
    "orderIndex": 1,
    "originalPrice": 35900,
    "dealPrice": 29900,
    "currency": "THB",
    "dealStartAt": "2026-02-17T00:00:00.000Z",
    "dealEndAt": "2026-02-28T23:59:59.000Z",
    "dealBadge": "SALE 17%",
    "dealUrl": "https://example.com/deal/product-abc",
    "note": "โปรโมชั่นเดือนกุมภาพันธ์"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
